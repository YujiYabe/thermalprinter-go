### 変数の定義（環境に合わせて変更）
@baseUrl = http://localhost:1323
@contentType = application/json

### パターン0
POST {{baseUrl}}/print
Content-Type: {{contentType}}

{
  "layout": [
    { "type": "space"},
    { "type": "line"},
    { "type": "text", "text": "福島local", "align": "center", "bold": true, "width": 2, "height": 2 },
    { "type": "line"},
    { "type": "text", "text": "2025/01/05 13:12:14", "align": "center", "bold": false, "width": 1, "height": 1 },
    { "type": "line"},
    { "type": "feed", "feed": 1 },
    { "type": "cut" }
  ]
}

