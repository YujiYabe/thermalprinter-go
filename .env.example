# Copy this file to .env and adjust values as needed

# Raw device path for the printer
PRINTER_DEVICE=/dev/usb/lp0

# Echo server port (can be "1323" or ":1323")
ECHO_PORT=1323

# Scheme: http or https (default http)
ECHO_SCHEME=http

# TLS certificate and key (for HTTPS)
ECHO_CERT_FILE=server.crt
ECHO_KEY_FILE=server.key
